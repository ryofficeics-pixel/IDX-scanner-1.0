# Generate with: openssl rand -hex 32
STOCKBIT_GATEWAY_TOKEN=

PORT=8787
HOST=0.0.0.0

# The app sends recommendations first. Deep quote/orderbook/fundamental calls are
# limited to these first symbols; broker flow is requested for every symbol.
STOCKBIT_GATEWAY_DETAIL_SYMBOL_LIMIT=5
STOCKBIT_GATEWAY_SYMBOL_CONCURRENCY=4
STOCKBIT_GATEWAY_RATE_LIMIT_PER_MINUTE=30

# LATEST | YESTERDAY | LAST_7_DAYS | LAST_3_MONTHS | YEAR_TO_DATE
STOCKBIT_GATEWAY_BROKER_PERIOD=LAST_7_DAYS

# Stockbit detector amounts below this absolute value are reported as neutral.
STOCKBIT_GATEWAY_FLOW_THRESHOLD_IDR=1000000000

# Keep this directory on a persistent volume. Do not expose it to the web.
STOCKBIT_STORE_DIR=/data/stockbit
