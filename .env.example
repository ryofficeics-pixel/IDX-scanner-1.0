# Optional Telmi Finance Open API enrichment (read-only, requested when app opens)
TELMI_API_KEY=
TELMI_API_BASE_URL=https://api-finance.telmi.id/api/v1/open

# Optional self-hosted Stockbit read-only gateway. Remote URLs must use HTTPS.
# Generate a token of at least 32 characters; `openssl rand -hex 32` is recommended.
# The endpoint must accept POST {"symbols":["BBCA", "BBRI"]}.
STOCKBIT_GATEWAY_URL=
STOCKBIT_GATEWAY_TOKEN=
STOCKBIT_GATEWAY_TIMEOUT_MS=9000

# Existing optional integrations
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NTFY_TOPIC=
